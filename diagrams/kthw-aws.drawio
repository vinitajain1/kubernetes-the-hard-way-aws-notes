  </diagram>
  <diagram id="kthw-pki" name="Certificates (PKI)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="&lt;b&gt;Certificates and how components use them&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="jb" value="jumpbox" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="560" as="geometry"/></mxCell>
        <mxCell id="sv" value="server · server.kubernetes.local" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="500" height="560" as="geometry"/></mxCell>
        <mxCell id="n0" value="node-0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="420" height="270" as="geometry"/></mxCell>
        <mxCell id="n1" value="node-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;arcSize=3;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="390" width="420" height="260" as="geometry"/></mxCell>
        <mxCell id="ca" value="&lt;b&gt;Certificate authority&lt;/b&gt;&lt;br&gt;ca.key: signs every certificate&lt;br&gt;ca.crt: trust anchor, copied to every machine" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="65" y="140" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="kubectl" value="&lt;b&gt;kubectl&lt;/b&gt;&lt;br&gt;admin.crt + admin.key&lt;br&gt;CN=admin&lt;br&gt;O=system:masters" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="65" y="500" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="kcm" value="&lt;b&gt;kube-controller-manager&lt;/b&gt;&lt;br&gt;kube-controller-manager.crt&lt;br&gt;signs new cert requests with ca.key&lt;br&gt;puts ca.crt in every namespace" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="445" y="140" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="ks" value="&lt;b&gt;kube-scheduler&lt;/b&gt;&lt;br&gt;kube-scheduler.crt&lt;br&gt;CN=system:kube-scheduler" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="680" y="140" width="215" height="110" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;kube-apiserver :6443&lt;/b&gt;&lt;br&gt;serves kube-api-server.crt (CN=kubernetes)&lt;br&gt;SANs: server.kubernetes.local, 10.32.0.1, kubernetes.default, 127.0.0.1 …&lt;br&gt;checks client certs against ca.crt&lt;br&gt;signs pod tokens with service-accounts.key, checks them with service-accounts.crt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="445" y="300" width="450" height="130" as="geometry"/></mxCell>
        <mxCell id="etcd" value="&lt;b&gt;etcd&lt;/b&gt;&lt;br&gt;http://127.0.0.1:2379 (no TLS)&lt;br&gt;Secrets encrypted at rest (Lab 06)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="kl0" value="&lt;b&gt;kubelet :10250&lt;/b&gt;&lt;br&gt;node-0.crt (as kubelet.crt)&lt;br&gt;CN=system:node:node-0&lt;br&gt;O=system:nodes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1025" y="135" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="kp0" value="&lt;b&gt;kube-proxy&lt;/b&gt;&lt;br&gt;kube-proxy.crt&lt;br&gt;CN=system:kube-proxy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1220" y="135" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="pod" value="&lt;b&gt;pod&lt;/b&gt; · no certificate, uses a service account token" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1025" y="280" width="375" height="55" as="geometry"/></mxCell>
        <mxCell id="kl1" value="&lt;b&gt;kubelet :10250&lt;/b&gt;&lt;br&gt;node-1.crt (as kubelet.crt)&lt;br&gt;CN=system:node:node-1&lt;br&gt;O=system:nodes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1025" y="435" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="kp1" value="&lt;b&gt;kube-proxy&lt;/b&gt;&lt;br&gt;kube-proxy.crt&lt;br&gt;CN=system:kube-proxy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1220" y="435" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="d1" value="Lab 04: scp certs + keys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;fontColor=#666666;fontStyle=0;exitX=1;exitY=0.25;entryX=0;entryY=0.1;" edge="1" parent="1" source="ca" target="sv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;fontColor=#666666;fontStyle=0;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="ca" target="n0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1" value="1 · mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="kubectl" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c3a" value="3 · mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#6C8EBF;" edge="1" parent="1" source="kcm" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c3b" value="3 · mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#6C8EBF;" edge="1" parent="1" source="ks" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2a" value="2 · mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#6C8EBF;exitX=0;exitY=0.75;entryX=1;entryY=0.25;" edge="1" parent="1" source="kl0" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c3c" value="3 · mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#6C8EBF;exitX=0.5;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="kp0" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2b" value="2 · mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#6C8EBF;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="kl1" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c3d" value="3 · mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#6C8EBF;exitX=0.5;exitY=1;entryX=0.75;entryY=1;" edge="1" parent="1" source="kp1" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c4" value="4 · mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#82B366;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="kl0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c5" value="5 · TLS + token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#9673A6;dashed=1;dashPattern=1 3;exitX=0;exitY=0.5;entryX=1;entryY=0.6;" edge="1" parent="1" source="pod" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c6" value="6 · plain HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#B85450;dashed=1;" edge="1" parent="1" source="api" target="etcd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;How each connection is secured&lt;/b&gt;&lt;br&gt;All certificates are signed by ca.key. Every machine holds ca.crt and rejects any certificate it didn&#x27;t sign.&lt;br&gt;&lt;b&gt;mTLS&lt;/b&gt; = both sides present a certificate. &lt;b&gt;TLS + token&lt;/b&gt; = only the server has a certificate; the client proves who it is with a token. &lt;b&gt;Plain HTTP&lt;/b&gt; = no encryption.&lt;br&gt;&lt;br&gt;&lt;b&gt;1. kubectl to API server · mTLS&lt;/b&gt; (server.kubernetes.local:6443): kubectl checks the server cert is signed by ca.crt and lists server.kubernetes.local. It presents admin.crt; the API server reads CN=admin, O=system:masters and grants full access.&lt;br&gt;&lt;b&gt;2. kubelet to API server · mTLS&lt;/b&gt;: presents node-0.crt / node-1.crt. The node authorizer limits each node to its own pods and their Secrets.&lt;br&gt;&lt;b&gt;3. kube-proxy, scheduler, controller manager to API server · mTLS&lt;/b&gt;: each presents its own cert; built-in RBAC roles are bound to its CN. All use https://server.kubernetes.local:6443; for the scheduler and controller manager that name points back to the server itself.&lt;br&gt;&lt;b&gt;4. API server to kubelet :10250 · mTLS&lt;/b&gt; (kubectl logs, exec): the API server logs in with kube-api-server.crt and checks the kubelet&#x27;s node-0.crt (SAN node-0) against ca.crt.&lt;br&gt;&lt;b&gt;5. pod to API server · TLS + token&lt;/b&gt; (10.32.0.1): the pod checks the server cert (SAN 10.32.0.1) against the ca.crt the controller manager placed in its namespace, then sends a service account token signed by the API server with service-accounts.key. Pods have no client certificate.&lt;br&gt;&lt;b&gt;6. API server to etcd · plain HTTP&lt;/b&gt; (127.0.0.1:2379): etcd listens only on localhost, so the traffic never leaves the server. Production clusters use mTLS here.&lt;br&gt;&lt;br&gt;Certificates reach each component through its kubeconfig (Lab 05). ca.key lives only on the jumpbox and the server, where the controller manager uses it to sign new certificate requests." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#999999;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1380" height="330" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
